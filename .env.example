# =============================================================================
# Polimar TTS — variabili d'ambiente (DevOps)
# Copia in .env e adatta. NON committare .env con valori reali.
# =============================================================================

# --- Server bind (NPM deve raggiungere 0.0.0.0, non localhost-only) ---
HOST=0.0.0.0
PORT=8765

# --- Root dati utente (upload, voci, job, export WAV/MP3) ---
# Percorso assoluto o relativo alla root del repo
DATA_DIR=./data

# --- Autenticazione (placeholder — il backend definisce l'uso esatto) ---
# Segreti per JWT/sessioni; generare con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-generate-a-random-secret
API_KEY=change-me-optional-static-api-key

# --- Upload limits (allineare con NPM client_max_body_size) ---
MAX_UPLOAD_BYTES=52428800
# MAX_UPLOAD_MB=50

# --- Modello Qwen3-TTS ---
MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-Base

# Device inference: cpu (default sicuro) | xpu (Intel Arc, sperimentale) | cuda
TTS_DEVICE=cpu

# Override cache modelli (opzionale; default: HF_HOME / %USERPROFILE%\.cache\huggingface)
# MODEL_CACHE_DIR=./models/cache
# HF_HOME=%USERPROFILE%\.cache\huggingface

# --- Worker / coda GPU ---
# Un solo job GPU alla volta; non aumentare senza hardware aggiuntivo
GPU_QUEUE_WORKERS=1

# --- Logging (opzionale) ---
# LOG_LEVEL=info
