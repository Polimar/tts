# Server
TTS_HOST=0.0.0.0
TTS_PORT=8765

# Secrets (change in production)
TTS_SECRET_KEY=change-me-to-a-long-random-string
TTS_TOKEN_EXPIRE_HOURS=168

# Data directory (users, voices, exports, database)
TTS_DATA_DIR=./data

# Model
TTS_MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-Base
TTS_MODEL_LOCAL_DIR=

# Limits
TTS_MAX_UPLOAD_BYTES=20971520
TTS_MAX_TEXT_CHARS=500000
TTS_CHUNK_MAX_CHARS=400
TTS_WARMUP_TEXT=Ciao, questo è un test di sintesi vocale.

# Worker
TTS_MOCK_WORKER=0
TTS_QUEUE_POLL_SECONDS=0.5
