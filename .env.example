# =============================================================================
# Polimar TTS — variabili d'ambiente (DevOps)
# Copia in .env e adatta. NON committare .env con valori reali.
# =============================================================================

# --- Server bind (NPM deve raggiungere 0.0.0.0, non localhost-only) ---
HOST=0.0.0.0
PORT=8765

# --- Registrazione ---
# Default 0 (produzione / dominio pubblico): POST /api/v1/auth/register richiede header X-API-Key.
# Impostare 1 solo su box locale/dev (mock o LAN), mai su tts.alevale.it con Qwen3 reale.
ALLOW_PUBLIC_REGISTRATION=0

# --- Root dati utente (upload, voci, job, export WAV/MP3) ---
# Se omesso, default FUORI dal repo:
#   Windows: %LOCALAPPDATA%\Polimar\tts
#   Linux:   ~/.local/share/polimar-tts (o $XDG_DATA_HOME/polimar-tts)
# Override esplicito solo se necessario:
# DATA_DIR=C:\Users\You\AppData\Local\Polimar\tts

# --- Autenticazione (SOLO placeholder — genera valori reali in .env locale) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-generate-a-random-secret
API_KEY=change-me-optional-static-api-key
TOKEN_EXPIRE_HOURS=168
LOGIN_RATE_LIMIT_PER_MINUTE=10

# HTTP deadlines (seconds) — return 504/503 instead of hanging the event loop
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_UPLOAD_TIMEOUT_SECONDS=120
DB_LOCK_TIMEOUT_SECONDS=5
WORKER_BOOT_TIMEOUT_SECONDS=600

# --- Upload limits (allineare con NPM client_max_body_size) ---
MAX_UPLOAD_BYTES=20971520

# --- Modello Qwen3-TTS ---
MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-Base

# Device inference — default CPU (percorso locale supportato)
# XPU sperimentale / fail-closed (Gate 2 Researcher):
# - device_map="xpu" load + full generate can work; .to("xpu") alone on CPU load is broken.
# - On Win Ultra 9 285H + Arc 140T: XPU warmup ~15.7s/6.86s vs CPU 4.96s → NO-GO (slower).
# - Never .to() between devices: fail-closed = dispose model + reload device_map="cpu".
# TTS_DEVICE=cpu; XPU only if full warmup generate succeeds AND beats CPU timing.
TTS_DEVICE=cpu

# Override cache modelli (opzionale; default: HF_HOME / %USERPROFILE%\.cache\huggingface)
# MODEL_CACHE_DIR=./models/cache
# HF_HOME=%USERPROFILE%\.cache\huggingface

# --- Worker / coda inference (un job alla volta sul device attivo) ---
GPU_QUEUE_WORKERS=1
QUEUE_POLL_SECONDS=0.5
MAX_TEXT_CHARS=500000
CHUNK_MAX_CHARS=400
WARMUP_TEXT=Ciao, questo è un test di sintesi vocale.

# --- Dev / test (no model load) — DevOps usa TTS_MOCK_WORKER ---
TTS_MOCK_WORKER=0
# MOCK_WORKER=0

# OpenAPI / Swagger UI (default off in production)
DEBUG=0
# DEV=1

# --- Logging (opzionale) ---
# LOG_LEVEL=info
